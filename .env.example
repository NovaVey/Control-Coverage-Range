# Copy to .env. This file only configures the RANGE's own docker-compose
# assembly (Postgres + Principal-Graph app + RBA app + ADC mint service) and
# the scenario runner that drives calls through them. It intentionally
# mirrors each sibling project's own .env.example naming rather than
# inventing new names for the same concept.

# ---- Shared Postgres (one instance, two logical databases) ----
# Principal-Graph and RBA each get their own database on this one Postgres
# server (see docker-compose.yml) so the Range can seed/inspect both without
# standing up two separate database containers.
POSTGRES_USER=range
POSTGRES_PASSWORD=range-dev-only
PRINCIPAL_GRAPH_DB=principalgraph
RBA_DB=authz_service

# ---- Principal-Graph (stack/principal-graph) ----
# Report API is read-only; see PrincipalGraphAdapter (src/adapters/principal-graph.ts).
PRINCIPAL_GRAPH_REPORT_API_KEY=range-dev-only-principal-graph-report-key
PRINCIPAL_GRAPH_REPORT_BASE_URL=http://localhost:8080
# Seeding grants/principals/resources into Principal-Graph's own schema has no
# HTTP write route (see GAPS.md #2) — the Range writes directly to this URL,
# replicating src/upsert.ts's own upsert pattern.
PRINCIPAL_GRAPH_DATABASE_URL=postgresql://range:range-dev-only@localhost:5432/principalgraph

# ---- Relationship-Based-Authorization (stack/relationship-based-authorization) ----
# Must be >=32 chars — RBA's own src/config/env.ts rejects anything shorter.
RBA_ADMIN_API_KEY=range-dev-only-rba-admin-key-32-chars-min
RBA_BASE_URL=http://localhost:3000

# ---- Attenuated-Delegation-Chain mint service (stack/attenuated-delegation-chain/services/mint) ----
# Generate with: node -e "console.log(Buffer.from(require('@adc/core').generateKeypair().secretKey).toString('base64'))"
MINT_ROOT_SECRET_KEY_B64=
MINT_ADMIN_API_KEY=range-dev-only-mint-admin-key
MINT_BASE_URL=http://localhost:3001
# The mint service's own event-emission mechanism (docs/PLAN.md Phase 6) — the
# Range tails this NDJSON file to feed Principal-Graph's grant graph, since
# neither project ships that wiring itself (see GAPS.md #3 / ARCHITECTURE.md).
# This is the *host* path — docker-compose.yml bind-mounts the mint container's own
# /var/log/adc-mint to ./.range-mint-events on the host precisely so this value and the
# container's internal MINT_GRAPH_EVENTS_PATH can both stay true at once without being the
# same literal string. Relative to wherever this CLI is invoked from (repo root, same as
# every `npm run range:*` script and CI's own working directory).
MINT_GRAPH_EVENTS_PATH=./.range-mint-events/events.ndjson
